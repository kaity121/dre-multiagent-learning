# Copy file này thành .env rồi điền key thật, KHÔNG commit .env lên git
OPENAI_API_KEY=sk-xxxxxxxxxxxxxxxxxxxxxxxx

# Model routing — Bo & Assessor dùng gpt-6-sol, Cô Lam dùng gpt-6.1-sol chuyên sâu
BO_MODEL=gpt-6-sol
ASSESSOR_MODEL=gpt-6-sol
COLAM_MODEL=gpt-6.1-sol

# Live clip extraction (issue #5): Whisper cho lời giảng, model vision đọc bảng phấn
STT_MODEL=whisper-1
VISION_MODEL=gpt-6-sol

PORT=3001
