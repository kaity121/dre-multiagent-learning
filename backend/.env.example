# Copy file này thành .env rồi điền key thật, KHÔNG commit .env lên git
OPENAI_API_KEY=sk-xxxxxxxxxxxxxxxxxxxxxxxx

# Model routing — Bo & Assessor dùng model rẻ/nhanh, Cô Lam dùng model tốt hơn
# vì lời chốt kiến thức sai một câu là hỏng uy tín "giáo viên"
